      COMETBFT_P2P_PERSISTENT_PEERS: "6678a01f08728ef00ff438c3517213773d92136d@validator-1:26656,e24dcf6bcdf202b991ce0d0a3a6fc623f260ba0d@validator-2:26656,af2acabc841ab5622556d01021c9f1a6a038d97a@validator-3:26656,1b6cbe9bafe79fb977ba59dbe237f64cc91fbe2b@validator-5:26656,faa57dcd8de29025d52785044e21cf1f703c63ac@validator-6:26656,2ff901c93ec6d8ede51767c56eaf678b7901a611@validator-7:26656"
      ATTESTATION_PEERS: http://validator-1:8080,http://validator-2:8080,http://validator-3:8080,http://validator-5:8080,http://validator-6:8080,http://validator-7:8080
      NEAR_SIGNER_ACCOUNT_ID: "certen-v4.testnet"
