# Certen validator topology — SEVEN validators plus postgres.
#
# This is the tracked template. The live file is docker-compose.yml, which is gitignored ONLY
# because it used to carry secrets inline; those now live in .env.shared (also gitignored) and
# are injected via `env_file:`. Nothing secret should ever reappear here — if you add a key,
# put it in .env.shared and let env_file deliver it.
#
# Note that `env_file:` populates variables INSIDE the container. It does NOT provide values for
# ${VAR} substitution in this file — compose takes those from the shell or a file literally named
# .env. That is why secrets are simply absent here rather than referenced as ${...}.
#
# ---------------------------------------------------------------------------
# validator-3 publishes 8093 / 26766 / 26767, NOT the 8083 / 26676 / 26677 its
# siblings' numbering implies. DO NOT "correct" this.
#
# Docker retained a corrupt endpoint record for certen-validator-3 that reserved every port it
# published — no OS listener, no docker-proxy, no container behind it, yet every start failed
# with "port is already allocated". The daemon could not be restarted and the network could not
# be recreated: both are shared with certen-gateway, api-bridge, proof-service and
# cardano-tx-server. Remapping to free ports was the only fix that did not disturb other tenants.
#
# Host ports are for external access only — peers reach each other over the compose network on
# 26656/26657, so the remap is invisible to consensus. Observed 2026-08-04.
# ---------------------------------------------------------------------------

services:
  postgres:
    image: postgres:15-alpine
    env_file: .env.shared
    container_name: certen-postgres
    environment:
      POSTGRES_DB: certen_proofs
      POSTGRES_USER: certen
    volumes:
      - postgres_data:/var/lib/postgresql/data
      # Migrations are now handled by the app's MigrateUp() function
      # This avoids version mismatch and nested transaction issues
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U certen -d certen_proofs"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    restart: unless-stopped
    networks:
      - certen-net

  validator-1:
    build: .
    container_name: certen-validator-1
    hostname: validator-1
    ports:
      - "8081:8080"
      - "26656:26656"
      - "26657:26657"
    env_file: .env.shared
    environment:
      VALIDATOR_ID: validator-1
      COMETBFT_P2P_SEEDS: "e24dcf6bcdf202b991ce0d0a3a6fc623f260ba0d@validator-2:26656,af2acabc841ab5622556d01021c9f1a6a038d97a@validator-3:26656,960da0d351187c61f1732308e1168833c9610946@validator-4:26656,1b6cbe9bafe79fb977ba59dbe237f64cc91fbe2b@validator-5:26656,faa57dcd8de29025d52785044e21cf1f703c63ac@validator-6:26656,2ff901c93ec6d8ede51767c56eaf678b7901a611@validator-7:26656"
      COMETBFT_P2P_PERSISTENT_PEERS: "e24dcf6bcdf202b991ce0d0a3a6fc623f260ba0d@validator-2:26656,af2acabc841ab5622556d01021c9f1a6a038d97a@validator-3:26656,960da0d351187c61f1732308e1168833c9610946@validator-4:26656,1b6cbe9bafe79fb977ba59dbe237f64cc91fbe2b@validator-5:26656,faa57dcd8de29025d52785044e21cf1f703c63ac@validator-6:26656,2ff901c93ec6d8ede51767c56eaf678b7901a611@validator-7:26656"
      ATTESTATION_PEERS: http://validator-2:8080,http://validator-3:8080,http://validator-4:8080,http://validator-5:8080,http://validator-6:8080,http://validator-7:8080
      NEAR_SIGNER_ACCOUNT_ID: "certen-v1.testnet"
    volumes:
      - validator1_data:/app/data
      - validator1_keys:/app/bft-keys
      - ./bls_zk_keys:/app/bls_zk_keys:ro
      - ./bls_zk_keys_bls12381:/app/bls_zk_keys_bls12381:ro
      - ./bls_zk_keys_bls12381_v2:/app/bls_zk_keys_bls12381_v2:ro
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped
    networks:
      - certen-net

  validator-2:
    build: .
    container_name: certen-validator-2
    hostname: validator-2
    ports:
      - "8082:8080"
      - "26666:26656"
      - "26667:26657"
    env_file: .env.shared
    environment:
      VALIDATOR_ID: validator-2
      COMETBFT_P2P_SEEDS: "6678a01f08728ef00ff438c3517213773d92136d@validator-1:26656,af2acabc841ab5622556d01021c9f1a6a038d97a@validator-3:26656,960da0d351187c61f1732308e1168833c9610946@validator-4:26656,1b6cbe9bafe79fb977ba59dbe237f64cc91fbe2b@validator-5:26656,faa57dcd8de29025d52785044e21cf1f703c63ac@validator-6:26656,2ff901c93ec6d8ede51767c56eaf678b7901a611@validator-7:26656"
      COMETBFT_P2P_PERSISTENT_PEERS: "6678a01f08728ef00ff438c3517213773d92136d@validator-1:26656,af2acabc841ab5622556d01021c9f1a6a038d97a@validator-3:26656,960da0d351187c61f1732308e1168833c9610946@validator-4:26656,1b6cbe9bafe79fb977ba59dbe237f64cc91fbe2b@validator-5:26656,faa57dcd8de29025d52785044e21cf1f703c63ac@validator-6:26656,2ff901c93ec6d8ede51767c56eaf678b7901a611@validator-7:26656"
      ATTESTATION_PEERS: http://validator-1:8080,http://validator-3:8080,http://validator-4:8080,http://validator-5:8080,http://validator-6:8080,http://validator-7:8080
      NEAR_SIGNER_ACCOUNT_ID: "certen-v2.testnet"
    volumes:
      - validator2_data:/app/data
      - validator2_keys:/app/bft-keys
      - ./bls_zk_keys:/app/bls_zk_keys:ro
      - ./bls_zk_keys_bls12381:/app/bls_zk_keys_bls12381:ro
      - ./bls_zk_keys_bls12381_v2:/app/bls_zk_keys_bls12381_v2:ro
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped
    networks:
      - certen-net

  validator-3:
