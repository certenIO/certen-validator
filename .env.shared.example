# =============================================================================
# Shared environment variables for all Certen validator services
# Copy to .env.shared and fill in values.
# Usage: env_file: .env.shared in docker-compose.yml per service
# =============================================================================

# Database
DATABASE_URL=postgres://certen:certen_testnet_2026@postgres:5432/certen_proofs?sslmode=disable

# CometBFT common settings
COMETBFT_ENABLED=true
COMETBFT_MODE=validator
COMETBFT_CHAIN_ID=certen-testnet
COMETBFT_RPC_URL=http://127.0.0.1:26657
COMETBFT_P2P_LADDR=tcp://0.0.0.0:26656
COMETBFT_RPC_LADDR=tcp://0.0.0.0:26657

# Accumulate endpoints
ACCUMULATE_URL=https://kermit.accumulatenetwork.io
ACCUMULATE_COMET_DN=<ACCUMULATE_DN_RPC>
ACCUMULATE_COMET_BVN=<ACCUMULATE_BVN_RPC>
ACCUMULATE_COMET_BVN1=<ACCUMULATE_BVN1_RPC>
ACCUMULATE_COMET_BVN2=<ACCUMULATE_BVN2_RPC>
ACCUMULATE_COMET_BVN3=<ACCUMULATE_BVN3_RPC>

# Ethereum / EVM primary
ETHEREUM_URL=<ETHEREUM_SEPOLIA_RPC_URL>
ETH_CHAIN_ID=11155111

# Supported chains ONLY: Ethereum Sepolia (11155111), Base Sepolia (84532), Arbitrum Sepolia (421614).
# CERTEN_SETTLEMENT_CHAINS names the ones CERTEN settles on NOW (required, no default, identical on every validator - a
# leg on any other chain is refused by name at consensus, RB5-F33). Each named chain needs its RPC and its
# CertenAnchorV8_2, which is read back at startup: a chain whose anchor is not a V8.2 stops the start.
CERTEN_SETTLEMENT_CHAINS=11155111,84532,421614
ETHEREUM_SEPOLIA_RPC_URL=<URL>
BASE_SEPOLIA_RPC_URL=<URL>
ARBITRUM_SEPOLIA_RPC_URL=<URL>
CERTEN_ANCHOR_V8_11155111=<CertenAnchorV8_2 on Sepolia>
CERTEN_ANCHOR_V8_84532=<CertenAnchorV8_2 on Base Sepolia>
CERTEN_ANCHOR_V8_421614=<CertenAnchorV8_2 on Arbitrum Sepolia>
# Each settlement chain's CertenOutcomeRegistryV1 (RB5 D4), required: it must record that chain's anchor and have been
# deployed on that chain, both read back at startup.
CERTEN_OUTCOME_REGISTRY_11155111=<CertenOutcomeRegistryV1 on Sepolia>
CERTEN_OUTCOME_REGISTRY_84532=<CertenOutcomeRegistryV1 on Base Sepolia>
CERTEN_OUTCOME_REGISTRY_421614=<CertenOutcomeRegistryV1 on Arbitrum Sepolia>
# Each settlement chain's account leaf version (RB5-F57), as <chainId>=<version> pairs over the defaults, which put all
# three chains on v3 (CertenAccountV7_2, factory V10). v4 is CertenAccountV7_3 (factory V11), whose leaf binds the
# member's deadline. Set it on all 7 validators at once, and only after the chain's factory V11 is deployed and its
# accounts relinked. A settlement chain on no version, or an unknown version, stops the start.
#CERTEN_ACCOUNT_LEAF_VERSIONS=84532=v4

# The validator set this node signs for - exactly as registered on the anchors (their currentValidatorSetRoot
# must equal the root these compute). Required: the node refuses to start without them (RB3-F21). The
# former CERTEN_V6_1_VALIDATOR_* names are still read; set only these.
CERTEN_VALIDATOR_SET_ADDRESSES=<the registered validator addresses, comma-separated>
CERTEN_VALIDATOR_SET_POWERS=<their voting powers, comma-separated, in the same order>
CERTEN_VALIDATOR_SET_THRESHOLD_NUM=2
CERTEN_VALIDATOR_SET_THRESHOLD_DEN=3
# Retired generations (anchors V3-V6.1, factories V6, CERTEN_CONTRACT_ADDRESS) are not read by the live
# path and must not be configured (RB3-F21).

# Non-EVM RPC URLs
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
APTOS_TESTNET_RPC_URL=https://fullnode.testnet.aptoslabs.com/v1
SUI_TESTNET_RPC_URL=https://fullnode.testnet.sui.io:443
NEAR_TESTNET_RPC_URL=https://test.rpc.fastnear.com
TON_TESTNET_API_URL=https://testnet.toncenter.com/api/v2

# Non-EVM Contract Addresses
# See deployment docs for current addresses per chain.

# =============================================================================
# Cost reporting (Model B billing)
# =============================================================================
# The validator fronts native gas on every chain, so what a leg COST is a
# commercial fact: the gateway prices from it, customers recompute invoices
# against it, and reconciliation compares charges to it. Unset these and the
# gateway's chain-priceability gate keeps refusing to price every chain — which
# is the correct failure direction, but nothing can be billed.
#
# The validator reports chain FACTS only (gas used, gas price, tx hash). It
# never sends a USD amount; the gateway converts with its own signed FX
# observation.
CERTEN_GATEWAY_URL=https://gateway.kompendium.co
# Must match the gateway's VALIDATOR_SERVICE_TOKEN_SECRET.
VALIDATOR_SERVICE_TOKEN_SECRET=
VALIDATOR_SERVICE_TOKEN_VERSION=v1
# Undelivered cost events survive restarts here. A crash between "leg confirmed"
# and "cost reported" would otherwise lose the number permanently while the
# chain has already charged us. Use a persistent volume, not tmpfs.
VALIDATOR_COST_WAL_DIR=data/cost-wal

# Endpoints the cost probes query for fee data. Point these at the SAME nodes
# that executed the transactions — a different provider may not have indexed
# them, or may have pruned them.
# SOLANA_RPC_URL / SUI_RPC_URL / APTOS_RPC_URL / NEAR_RPC_URL fall back to the
# *_TESTNET_* variables above when unset.
NEAR_ACCOUNT_ID=
TON_API_KEY=
CARDANO_API_URL=
CARDANO_PROJECT_ID=

# Logging and proof settings
LOG_LEVEL=info
PROOF_CYCLE_WRITEBACK=true
ATTESTATION_REQUIRED_COUNT=5

# Accumulate identity and signing
ACCUMULATE_SIGNER_URL=<ACCUMULATE_SIGNER_KEYPAGE_URL>
ACCUMULATE_WRITEBACK_PRIV_KEY=<ACCUMULATE_PRIVATE_KEY>
ACCUMULATE_RESULTS_PRINCIPAL=<ACCUMULATE_DATA_ACCOUNT_URL>

# Certen identity
CERTEN_IDENTITY=<CERTEN_ADI_URL>
CERTEN_IDENTITY_BOOK=<CERTEN_ADI_URL>/book
CERTEN_IDENTITY_KEYPAGE=<CERTEN_ADI_URL>/book/1
CERTEN_IDENTITY_DATA=<CERTEN_ADI_URL>/execution-results
CERTEN_KEYPAGE_PUBLIC_KEY=<PUBLIC_KEY_HEX>
CERTEN_KEYPAGE_PRIVATE_KEY=<PRIVATE_KEY_HEX>
