# ═══════════════════════════════════════════════════════════════
# Certen Protocol Independent Validator - Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# SECURITY: Never commit .env to version control
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# VALIDATOR IDENTITY
# ─────────────────────────────────────────────────────────────────

# Unique identifier for this validator (used for key generation and logging)
VALIDATOR_ID=validator-1

# Network name (devnet, kermit, mainnet)
NETWORK_NAME=testnet

# ─────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────

# PostgreSQL password (REQUIRED - change in production!)
POSTGRES_PASSWORD=change_me_in_production

# ─────────────────────────────────────────────────────────────────
# ACCUMULATE NETWORK
# ─────────────────────────────────────────────────────────────────

# Accumulate RPC endpoint (REQUIRED)
ACCUMULATE_URL=https://kermit.accumulatenetwork.io/v3

# CometBFT endpoints for L1-L3 chained proofs (optional)
ACCUMULATE_COMET_DN=
ACCUMULATE_COMET_BVN=

# ─────────────────────────────────────────────────────────────────
# ETHEREUM NETWORK
# ─────────────────────────────────────────────────────────────────

# Ethereum RPC endpoint (REQUIRED)
ETHEREUM_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Chain ID (11155111 = Sepolia, 1 = Mainnet)
ETH_CHAIN_ID=11155111

# Validator's Ethereum private key (REQUIRED)
ETH_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# ─────────────────────────────────────────────────────────────────
# CONTRACT ADDRESSES (Sepolia Testnet Defaults)
# ─────────────────────────────────────────────────────────────────

# The chains CERTEN settles on now (required, no default; the same on every validator) and each one's CertenAnchorV8_2,
# read back at startup; see .env.shared.example.
CERTEN_SETTLEMENT_CHAINS=11155111,84532,421614
CERTEN_ANCHOR_V8_11155111=<CertenAnchorV8_2 on Sepolia>
CERTEN_ANCHOR_V8_84532=<CertenAnchorV8_2 on Base Sepolia>
CERTEN_ANCHOR_V8_421614=<CertenAnchorV8_2 on Arbitrum Sepolia>

# ─────────────────────────────────────────────────────────────────
# COMETBFT CONSENSUS
# ─────────────────────────────────────────────────────────────────

COMETBFT_ENABLED=true
COMETBFT_MODE=validator
COMETBFT_CHAIN_ID=certen-testnet
COMETBFT_P2P_PERSISTENT_PEERS=

# Production validators verify the schema at startup and do not run DDL. Set true only for a disposable
# single-node development database; production deploys use `certen-validator migrate up` before restart.
MIGRATE_ON_START=false

# ─────────────────────────────────────────────────────────────────
# MULTI-VALIDATOR ATTESTATION
# ─────────────────────────────────────────────────────────────────

ATTESTATION_PEERS=
ATTESTATION_REQUIRED_COUNT=3

# ─────────────────────────────────────────────────────────────────
# BLS ZK CONFIGURATION
# ─────────────────────────────────────────────────────────────────

# Testing mode (set to false in production)

# ─────────────────────────────────────────────────────────────────
# PROOF CYCLE WRITE-BACK (required: every proof cycle writes its results back)
# ─────────────────────────────────────────────────────────────────

PROOF_CYCLE_WRITEBACK=true

# ─────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────

LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────
# FIRESTORE (Real-time UI Sync)
# ─────────────────────────────────────────────────────────────────

# Enable Firestore sync for real-time web app updates
FIRESTORE_ENABLED=false

# Firebase/GCP project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to Firebase service account JSON (required when FIRESTORE_ENABLED=true)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
