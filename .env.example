# ═══════════════════════════════════════════════════════════════
# Certen Protocol Independent Validator - Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# SECURITY: Never commit .env to version control
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# VALIDATOR IDENTITY
# ─────────────────────────────────────────────────────────────────

# Unique identifier for this validator (used for key generation and logging)
VALIDATOR_ID=validator-1

# Network name (devnet, kermit, mainnet)
NETWORK_NAME=testnet

# ─────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────

# PostgreSQL password (REQUIRED - change in production!)
POSTGRES_PASSWORD=change_me_in_production

# ─────────────────────────────────────────────────────────────────
# ACCUMULATE NETWORK
# ─────────────────────────────────────────────────────────────────

# Accumulate RPC endpoint (REQUIRED)
ACCUMULATE_URL=https://kermit.accumulatenetwork.io/v3

# CometBFT endpoints for L1-L3 chained proofs (optional)
ACCUMULATE_COMET_DN=
ACCUMULATE_COMET_BVN=

# ─────────────────────────────────────────────────────────────────
# ETHEREUM NETWORK
# ─────────────────────────────────────────────────────────────────

# Ethereum RPC endpoint (REQUIRED)
ETHEREUM_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Chain ID (11155111 = Sepolia, 1 = Mainnet)
ETH_CHAIN_ID=11155111

# Validator's Ethereum private key (REQUIRED)
ETH_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# ─────────────────────────────────────────────────────────────────
# CONTRACT ADDRESSES (Sepolia Testnet Defaults)
# ─────────────────────────────────────────────────────────────────

# The chains CERTEN settles on now (required, no default; the same on every validator) and each one's CertenAnchorV8_2,
# read back at startup; see .env.shared.example.
CERTEN_SETTLEMENT_CHAINS=11155111,84532,421614
CERTEN_ANCHOR_V8_11155111=<CertenAnchorV8_2 on Sepolia>
CERTEN_ANCHOR_V8_84532=<CertenAnchorV8_2 on Base Sepolia>
CERTEN_ANCHOR_V8_421614=<CertenAnchorV8_2 on Arbitrum Sepolia>
# Each settlement chain's CertenOutcomeRegistryV1 (RB5 D4), required: it must record that chain's anchor and have been
# deployed on that chain, both read back at startup.
CERTEN_OUTCOME_REGISTRY_11155111=<CertenOutcomeRegistryV1 on Sepolia>
CERTEN_OUTCOME_REGISTRY_84532=<CertenOutcomeRegistryV1 on Base Sepolia>
CERTEN_OUTCOME_REGISTRY_421614=<CertenOutcomeRegistryV1 on Arbitrum Sepolia>
# Each settlement chain's account leaf version (RB5-F57), as <chainId>=<version> pairs over the defaults, which put all
# three chains on v3 (CertenAccountV7_2, factory V10). v4 is CertenAccountV7_3 (factory V11), whose leaf binds the
# member's deadline. Set it on all 7 validators at once, and only after the chain's factory V11 is deployed and its
# accounts relinked. A settlement chain on no version, or an unknown version, stops the start.
#CERTEN_ACCOUNT_LEAF_VERSIONS=84532=v4

# Telcoin Adiri (2017) is in the chain catalogue but DISABLED by default: it is settled on only when
# CERTEN_SETTLEMENT_CHAINS names 2017 AND every line below is set (each missing one stops the start by name). Gas is
# paid in TEL, so the ceiling is gwei of TEL measured from Adiri's fee market - there is no compiled default. The
# fallbacks must be a second independent provider (RB5-F53: two agreeing hosts per settlement chain).
#TELCOIN_ADIRI_RPC_URL=<URL>
#TELCOIN_ADIRI_URL_FALLBACKS=<URL of an independent provider>
#TELCOIN_ADIRI_MAX_GAS_PRICE_GWEI=<gwei of TEL>
#TELCOIN_ADIRI_GAS_LIMIT_ANCHOR=<gas>
#CERTEN_ANCHOR_V8_2017=<CertenAnchorV8_2 on Telcoin Adiri>
#CERTEN_OUTCOME_REGISTRY_2017=<CertenOutcomeRegistryV1 on Telcoin Adiri>
# TEL's USD price for the dollar ceiling (0 leaves it inactive). CERTEN_NATIVE_USD is ETH's price and is never
# applied to TEL: an enabled 2017 without this stops the start. Any chain may name its own CERTEN_NATIVE_USD_<chainId>.
#CERTEN_NATIVE_USD_2017=<USD per TEL>
# ...and 2017=v4 in CERTEN_ACCOUNT_LEAF_VERSIONS (Adiri never deploys CertenAccountV7_2).
# Adiri makes a block only when a transaction lands or its epoch closes (every 6 h), so its time stops while it is idle.
# Settling on it requires the heartbeat (RB7 D7): when a rule waits only for a block past its horizon (a deadline plus
# its margin, a settlement window's fence, a leaf's notBefore), validator i sends one zero-value transfer to itself on
# 2017, 30 s + 15 s*(i-1) past the horizon, from its relayer key - which must hold TEL. The block decides; the wall clock
# only triggers. Without it an enabled 2017 stops the start by name. The chains whose blocks never stop have no
# heartbeat: setting CERTEN_CHAIN_HEARTBEAT_<id> for one of them stops the start.
#CERTEN_CHAIN_HEARTBEAT_2017=on

# ─────────────────────────────────────────────────────────────────
# COMETBFT CONSENSUS
# ─────────────────────────────────────────────────────────────────

COMETBFT_ENABLED=true
COMETBFT_MODE=validator
COMETBFT_CHAIN_ID=certen-testnet
COMETBFT_P2P_PERSISTENT_PEERS=

# Production validators verify the schema at startup and do not run DDL. Set true only for a disposable
# single-node development database; production deploys use `certen-validator migrate up` before restart.
MIGRATE_ON_START=false

# ─────────────────────────────────────────────────────────────────
# MULTI-VALIDATOR ATTESTATION
# ─────────────────────────────────────────────────────────────────

ATTESTATION_PEERS=
ATTESTATION_REQUIRED_COUNT=3

# ─────────────────────────────────────────────────────────────────
# BLS ZK CONFIGURATION
# ─────────────────────────────────────────────────────────────────

# Testing mode (set to false in production)

# ─────────────────────────────────────────────────────────────────
# PROOF CYCLE WRITE-BACK (required: every proof cycle writes its results back)
# ─────────────────────────────────────────────────────────────────

PROOF_CYCLE_WRITEBACK=true

# ─────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────

LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────
# FIRESTORE (Real-time UI Sync)
# ─────────────────────────────────────────────────────────────────

# Enable Firestore sync for real-time web app updates
FIRESTORE_ENABLED=false

# Firebase/GCP project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to Firebase service account JSON (required when FIRESTORE_ENABLED=true)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
